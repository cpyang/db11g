# Oracle installation packages (large files, need user to download)
packages/

# Installation media staging (11.2.0.4 zips live here, never committed;
# see staging/README.md). Directory contents are ignored except the note;
# the bare rule also silences a leftover top-level staging symlink.
/staging
!/staging/
/staging/*
!/staging/README.md

# Pinned ansible venv (ansible-core 2.16 for EL7/py3.6 targets)
.venv-ansible/

# Generated shared disks (legacy — new location: .vagrant/shared_disks/)
disks/

# Vagrant state
.vagrant/

# OS-generated files
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Ansible
ansible/*.retry
ansible/__pycache__/
ansible/roles/*/tasks/__pycache__/

# Logs
*.log
install_logs/
