# Oracle 11gR2 Database Installation Response File
# Generated by Ansible for {{ inventory_hostname }}

[GENERAL]
RESPONSEFILE_VERSION="11.2.0"
OPTION_UPGRADE="FALSE"

# Installation options
INSTALL_TYPE="EE"
ASSUMEACCRTPWDFORINSTALL="TRUE"

# Oracle Base and Home
ORACLE_HOME="{{ oracle_home }}"
ORACLE_BASE="{{ oracle_base }}"

# Licensing
s_nameForDBAGroup="{{ oracle_installer_group }}"
s_nameForOPERGroup="{{ oracle_oper_group }}"

# Network
INSTALL_OSDBA_GRP="{{ oracle_installer_group }}"
INSTALL_OSOPER_GRP="{{ oracle_oper_group }}"
INSTALL_OSBACKUPDBA_GRP="{{ oracle_oper_group }}"
INSTALL_OSDGDBA_GRP="{{ oracle_oper_group }}"
INSTALL_OSKGDBA_GRP="{{ oracle_oper_group }}"

# RAC configuration
b_racInstall="TRUE"
b_singleInstance="FALSE"
s_clusterNodes="{{ groups['rac'] | join(',') }}"
b_isCustomInstall="TRUE"

# Components to install
b_installEnterpriseManager="TRUE"
b_installEnterpriseManagerRepo="FALSE"
b_installEnterpriseManagerCentral="FALSE"
b_installOracleConfigManager="TRUE"

# Database configuration (if creating during install)
b_createDB="FALSE"

# Passwords (if needed)
s_nameForDBAGroup="{{ oracle_installer_group }}"
s_nameForOPERGroup="{{ oracle_oper_group }}"

# Upgrade options
b_ignoreNonFatalErrors="TRUE"
b_ignorePrereqs="TRUE"
