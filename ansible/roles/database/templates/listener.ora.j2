# Oracle 11gR2 RAC - Listener Configuration
# Generated by Ansible for {{ inventory_hostname }}

# Public listener
{{ inventory_hostname }}_LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[inventory_hostname]['public_ip'] | default(ansible_default_ipv4['address']) }})(PORT = 1521))
      (ADDRESS = (PROTOCOL = IPC)(KEY = EXTPROC1521))
    )
  )

# Private listener for cluster interconnect
{{ inventory_hostname }}_PRIV_LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[inventory_hostname]['private_ip'] | default('') }})(PORT = 1521))
    )
  )

# Static registration for ASM
SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = +{{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}.{{ inventory_hostname }})
      (ORACLE_HOME = {{ hostvars[inventory_hostname]['grid_home'] | default('/u01/app/11.2.0/grid') }})
      (SID_NAME = +{{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }})
    )
  )

# Static registration for database instance
SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = {{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }})
      (ORACLE_HOME = {{ hostvars[inventory_hostname]['oracle_home'] | default('/u01/app/oracle/product/11.2.0/dbhome_1') }})
      (SID_NAME = {{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }})
    )
  )

# SCAN listener
SCAN_LISTENER =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[groups['rac'][0]]['scan_ip'] | default('192.168.56.100') }})(PORT = 1521))
    )
  )

# Default listener
DEFAULT_Services_LISTENER = {{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }}
