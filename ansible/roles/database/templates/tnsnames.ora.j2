# tnsnames.ora — managed by Ansible (roles/database/templates/tnsnames.ora.j2)
# RAC NOTE: node listeners + SCAN listener are CRS resources created by GI
# (root.sh phase). This file only provides client connect aliases — it is
# deliberately NOT the place an 11.2 listener would be statically defined.

{{ db_name }}_SCAN =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ scan_name }})(PORT = {{ scan_port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ db_name }})
    )
  )

{% for host in groups['rac'] %}
{{ db_sid_prefix }}{{ hostvars[host].node_num }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[host].short_name }}-vip.{{ domain_name }})(PORT = {{ scan_port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ db_name }})
      (INSTANCE_NAME = {{ db_sid_prefix }}{{ hostvars[host].node_num }})
    )
  )

{% endfor %}
