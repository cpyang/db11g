# Oracle 11gR2 RAC - TNS Names Configuration
# Generated by Ansible

# SCAN listener (preferred connection method)
{{ hostvars[groups['rac'][0]]['sid_prefix'] | default('rac') }}_scan =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[groups['rac'][0]]['scan_ip'] | default('192.168.56.100') }})(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ hostvars[groups['rac'][0]]['sid_prefix'] | default('rac') }})
    )
  )

# Database instances
{% for host in groups['rac'] %}
{{ hostvars[host]['sid_prefix'] | default('rac') }}{{ host | regex_replace('db11g-','') }} =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[host]['public_ip'] | default('192.168.56.' + host | regex_replace('db11g-','')) }})(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[host]['vip'] | default('192.168.56.1' + host | regex_replace('db11g-','')) }})(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ hostvars[host]['sid_prefix'] | default('rac') }})
      (INSTANCE_NAME = {{ hostvars[host]['sid_prefix'] | default('rac') }}{{ host | regex_replace('db11g-','') }})
    )
  )

{% endfor %}

# ASM instance
{% for host in groups['rac'] %}
{{ hostvars[host]['sid_prefix'] | default('rac') }}_{{ host | regex_replace('db11g-','') }}_asm =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[host]['public_ip'] | default('192.168.56.' + host | regex_replace('db11g-','')) }})(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = +{{ hostvars[host]['sid_prefix'] | default('rac') }})
      (INSTANCE_NAME = +{{ hostvars[host]['sid_prefix'] | default('rac') }}{{ host | regex_replace('db11g-','') }})
    )
  )

{% endfor %}

# Local connection for current node
{{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }} =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ hostvars[inventory_hostname]['public_ip'] | default('192.168.56.' + inventory_hostname | regex_replace('db11g-','')) }})(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }})
      (INSTANCE_NAME = {{ hostvars[inventory_hostname]['sid_prefix'] | default('rac') }}{{ inventory_hostname | regex_replace('db11g-','') }})
    )
  )
