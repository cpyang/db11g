# Oracle 11gR2 RAC - Environment Variables
# Generated by Ansible

# Oracle Environment
export ORACLE_BASE={{ oracle_base }}
export PATH=$ORACLE_HOME/bin:$PATH
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:/lib:/usr/lib

# Prompt
export PS1="[\u@\h \W]\$ "

# Aliases
alias ll='ls -la'
alias sqlplus='sqlplus /nolog'
alias asmcmd='asmcmd'
