# Managed by Ansible — dnsmasq serves the cluster zone from /etc/hosts.
# 11.2.0.4 grid install wants the SCAN name resolvable via DNS; keeping
# dnsmasq answering (plus the hosts-file fallback) is what stops the
# CVU PRVF DNS/empty-set failure class on an otherwise-DNS-less lab.
domain={{ domain_name }}
expand-hosts
local=/{{ domain_name }}/
listen-address=127.0.0.1,{{ public_ip }}
bind-interfaces
cache-size=0
strict-order
# Upstream = the VirtualBox NAT resolver (eth0). 'no-resolv' here starved
# dnsmasq of any forwarder and ntpd/ yum could not resolve anything
# (di 2026-10-23 addNode PRVF-5410 postmortem). Override with -e dns_upstream=...
server={{ dns_upstream | default('10.0.2.3') }}
