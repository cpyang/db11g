# Oracle 11gR2 RAC - NTP Configuration
# Generated by Ansible

driftfile /var/lib/ntp/drift

# Disable ntpd to allow oracleasm to work properly
# In RAC, only one node needs NTP, others use cluster time sync
{% if inventory_hostname == groups['rac'][0] %}
restrict default nomodify notrap nopeer noquery
restrict 127.0.0.1
restrict ::1

# NTP Servers
{% for server in ntp_servers %}
server {{ server }} iburst
{% endfor %}

# Log file
logfile /var/log/ntp.log
{% else %}
# This node will sync time from the first RAC node
server {{ groups['rac'][0] }} iburst
restrict {{ groups['rac'][0] }} nomodify notrap noquery
{% endif %}
