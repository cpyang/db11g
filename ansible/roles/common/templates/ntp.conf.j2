# Managed by Ansible — ntp.conf (lab)
driftfile /var/lib/ntp/drift
logfile /var/log/ntp.log

restrict default nomodify notrap nopeer noquery
restrict 127.0.0.1
restrict ::1
restrict {{ network_public }}.0 mask 255.255.255.0 nomodify notrap
restrict {{ network_private }}.0 mask 255.255.255.0 nomodify notrap

# Both nodes sync the same external pool over the NAT interface — a
# node-to-node chain (old template) silently never synced because node1
# restricted queries from node2.
{% for server in ntp_servers %}
server {{ server }} iburst
{% endfor %}
