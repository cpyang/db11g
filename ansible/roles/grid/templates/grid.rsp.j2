# ============================================================
# Oracle Grid Infrastructure 11.2.0.4 silent response file.
# Key SET AND ORDER verified against the shipped template
# p13390677_112040_Linux-x86-64_3of7.zip -> grid/response/grid_install.rsp
# (saved at ansible/reference/grid_install.rsp.orig). This schema is the
# FLAT, section-less format — do not restyle it with [GENERAL]/[options]
# blocks and do not add 19c-era keys (unknown keys abort OUI parsing).
# ============================================================
oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v11_2_0
ORACLE_HOSTNAME={{ inventory_hostname }}
INVENTORY_LOCATION={{ ora_inventory }}
SELECTED_LANGUAGES=en
oracle.install.option=CRS_CONFIG
ORACLE_BASE={{ grid_base }}
ORACLE_HOME={{ grid_home }}

# OS groups (ASM administration belongs to grid; oracle is NOT the owner)
oracle.install.asm.OSDBA={{ oracle_asm_group }}
oracle.install.asm.OSOPER={{ oracle_asm_oper_group }}
oracle.install.asm.OSASM={{ oracle_asm_group }}

# Cluster + SCAN (static DNS via dnsmasq/hosts, no GNS)
oracle.install.crs.config.gpnp.scanName={{ scan_name }}
oracle.install.crs.config.gpnp.scanPort={{ scan_port }}
oracle.install.crs.config.clusterName={{ cluster_name }}
oracle.install.crs.config.gpnp.configureGNS=false
oracle.install.crs.config.gpnp.gnsSubDomain=
oracle.install.crs.config.gpnp.gnsVIPAddress=

# Explicit VIPs — autoConfigure=true against host-only NICs is the
# PRKC-1168 "AUTO address invalid" failure class in labs.
oracle.install.crs.config.autoConfigureClusterNodeVIP=false
# Install-phase cluster membership = FIRST NODE ONLY. Listing rac2 here
# makes runInstaller AttachHome + stamp SYSTEM.version.hostnames.<n2> in
# the OCR without any node registration — that orphan key then makes
# addNode refuse ('already part of the cluster') and root.sh's create scr
# 4046 forever (di 2026-10-23 phantom postmortem). node2's genuine
# registration is addNode.sh's job, run by the root phase before its
# root.sh (see roles/grid 'Register join node' task).
oracle.install.crs.config.clusterNodes={{ hostvars[groups['rac'][0]].short_name }}:{{ hostvars[groups['rac'][0]].short_name }}-vip.{{ domain_name }}

# Interfaces resolved BY ADDRESS at runtime (format iface:subnet:usage,
# 1=public 2=private 3=unused — the NAT NIC must be listed :3 or CVU probes it).
oracle.install.crs.config.networkInterfaceList={{ pub_iface }}:{{ network_public }}.0:1,{{ priv_iface }}:{{ network_private }}.0:2,{{ nat_iface | default('eth0') }}:{{ nat_subnet | default('10.0.2.0') }}:3

# Storage: ASM; OCR+voting land in the single disk group defined below
oracle.install.crs.config.storageOption=ASM_STORAGE
oracle.install.crs.config.sharedFileSystemStorage.diskDriveMapping=
oracle.install.crs.config.sharedFileSystemStorage.votingDiskLocations=
oracle.install.crs.config.sharedFileSystemStorage.votingDiskRedundancy=NORMAL
oracle.install.crs.config.sharedFileSystemStorage.ocrLocations=
oracle.install.crs.config.sharedFileSystemStorage.ocrRedundancy=NORMAL
oracle.install.crs.config.useIPMI=false
oracle.install.crs.config.ipmi.bmcUsername=
oracle.install.crs.config.ipmi.bmcPassword=

# ASM — first (and install-time only) disk group CRS holds OCR + voting.
# DATA/FRA are created by asmca after root.sh (playbook 03, stage=dgs).
oracle.install.asm.SYSASMPassword={{ asm_monitor_password }}
oracle.install.asm.diskGroup.name=CRS
oracle.install.asm.diskGroup.redundancy=EXTERNAL
oracle.install.asm.diskGroup.AUSize=4
oracle.install.asm.diskGroup.disks=/dev/oracleasm/disks/CRS
oracle.install.asm.diskGroup.diskDiscoveryString={{ asm_diskstring }}
oracle.install.asm.monitorPassword={{ asm_monitor_password }}
oracle.install.crs.upgrade.clusterNodes=
oracle.install.asm.upgradeASM=false

# No MyOracle support / autoupdates in a lab
oracle.installer.autoupdates.option=SKIP_UPDATES
oracle.installer.autoupdates.downloadUpdatesLoc=
AUTOUPDATES_MYORACLESUPPORT_USERNAME=
AUTOUPDATES_MYORACLESUPPORT_PASSWORD=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PWD=
PROXY_REALM=
