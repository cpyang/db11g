# Oracle 11gR2 Grid Infrastructure Response File
# Generated by Ansible for {{ inventory_hostname }}

[GENERAL]
RESPONSEFILE_VERSION="2.2.1"
OPTION_UPGRADE="TRUE"
OPTION_RAC="TRUE"

[CREATEGRID]
# Cluster configuration
CLUSTER_NAME="db11g-cluster"
OSDBA_GROUP="{{ oracle_asm_group }}"
OPER_GROUP="{{ oracle_oper_group }}"
ASMDBA_GROUP="{{ oracle_asm_group }}"

# Grid Home
GRID_HOME="{{ grid_home }}"
GRID_HOME_NAME="GI_{{ oracle_sw_version }}"

# Oracle Base
ORACLE_BASE="{{ oracle_base }}/../.."

# Network interfaces
# Note: eth0 = public, eth1 = private
NETWORK_INTERFACES_LIST="eth0:public:1,eth1:cluster:1"

# ASM configuration
ASMSNMP_PASSWORD="oracle"
ASM_SYSPASSWORD="oracle"
ASM_SYSOPER_PASSWORD="oracle"

# ASM disk groups
DISK_STRING="/dev/oracleasm/disks/*"

# SCAN configuration
SCAN_NAME="db11g-scan"
SCAN_PORT="{{ scan_port }}"

# Storage options
STORAGE_TYPE=ASM
ASM_DISKGROUPS=DATA,FRA
ASM_DISKSTRING="/dev/oracleasm/disks/*"

# ASM disk group specifications
DATA_REDUUNDANCY=EXTERNAL
DATA_DISKS=/dev/oracleasm/disks/OCR_VOTING,/dev/oracleasm/disks/DATA
FRA_REDUUNDANCY=EXTERNAL
FRA_DISKS=/dev/oracleasm/disks/FRA
FRA_FAST_RECOVERY_AREA=""

# Root script execution
rootScriptRun="true"
rootUserMapping="root"

# Ignore prerequisites (for testing)
ignoreInternalError="true"
ignoreInternalDatabaseError="true"
